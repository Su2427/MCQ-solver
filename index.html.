<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Exam Coach</title><link rel="manifest" href="manifest.json">
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js"></script>
<style>
:root{--bg:#f6f7fb;--fg:#0f172a;--card:#fff;--ac:#4f46e5;--ok:#16a34a;--bad:#dc2626;--bd:#d9dce8}
@media(prefers-color-scheme:dark){:root{--bg:#0f172a;--fg:#e5e7eb;--card:#1e293b;--bd:#334155}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px system-ui,sans-serif;padding:0 0 76px}
main{padding:14px;max-width:640px;margin:auto}.c{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin:0 0 12px}
button,select,input{font:inherit;color:inherit}button{background:var(--ac);color:#fff;border:0;border-radius:10px;padding:12px 14px;margin:4px 0;width:100%}
button.o{background:var(--card);color:var(--fg);border:1px solid var(--bd);text-align:left}button.g{background:transparent;color:var(--ac);border:1px solid var(--ac)}
input,select{width:100%;padding:10px;border:1px solid var(--bd);border-radius:10px;background:var(--card);margin:4px 0}
nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:var(--card);border-top:1px solid var(--bd);padding-bottom:env(safe-area-inset-bottom)}
nav button{background:none;color:var(--fg);border-radius:0;margin:0;font-size:12px;flex:1}nav button.on{color:var(--ac);font-weight:700}
.q{white-space:pre-wrap;font-size:17px}.r{display:flex;gap:8px;align-items:center;margin:6px 0;font-size:13px}.r span:first-child{width:78px}.bar{flex:1;height:10px;background:var(--bd);border-radius:5px;overflow:hidden}.bar i{display:block;height:100%;background:var(--ok)}small{opacity:.7}
</style></head><body><main id="app"></main>
<nav id="nav"></nav>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
if('serviceWorker'in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('sw.js');
const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
/* ---------- storage (IndexedDB) ---------- */
const DB=new Promise(r=>{const q=indexedDB.open('coach',1);q.onupgradeneeded=()=>{['papers','questions','attempts'].forEach(s=>q.result.createObjectStore(s,{keyPath:'id',autoIncrement:s=='attempts'}))};q.onsuccess=()=>r(q.result)});
const tx=async(s,m,f)=>{const d=await DB;return new Promise((res,rej)=>{const t=d.transaction(s,m),r=f(t.objectStore(s));t.oncomplete=()=>res(r&&r.result);t.onerror=()=>rej(t.error)})};
const put=(s,v)=>tx(s,'readwrite',o=>o.put(v)),all=s=>tx(s,'readonly',o=>o.getAll());
const putMany=(s,a)=>tx(s,'readwrite',o=>{a.forEach(v=>o.put(v))});
/* ---------- PDF + OCR ---------- */
async function pageText(pg){const tc=await pg.getTextContent();let y=null,s='';for(const it of tc.items){const yy=it.transform[5];if(y!==null&&Math.abs(yy-y)>3)s+='\n';else if(s&&!s.endsWith('\n'))s+=' ';s+=it.str;y=yy}return s}
async function ocr(pg,lang){const v=pg.getViewport({scale:2}),c=document.createElement('canvas');c.width=v.width;c.height=v.height;await pg.render({canvasContext:c.getContext('2d'),viewport:v}).promise;return (await Tesseract.recognize(c,lang)).data.text}
async function readPdf(f,lang,st){const pdf=await pdfjsLib.getDocument({data:await f.arrayBuffer()}).promise;let out='';
for(let i=1;i<=pdf.numPages;i++){st(`${f.name}: page ${i}/${pdf.numPages}`);const pg=await pdf.getPage(i);let t=await pageText(pg);if(t.trim().length<40||$('#fo').checked){st(`OCR page ${i}/${pdf.numPages}…`);t=await ocr(pg,lang)}out+=t+'\n'}return out}
/* ---------- parsing ---------- */
function parseKey(t){const m={};let x;const re=/(?:Q\.?\s*)?(\d{1,3})\s*[\.\-:\)=]?\s*[\(\[]?\s*([A-Ea-e])[\)\]]?(?=\s|,|;|$)/g;
while(x=re.exec(t))m[+x[1]]??=x[2].toUpperCase();
t.split('\n').forEach(l=>{const y=l.match(/^\s*(?:Q\.?\s*)?(\d{1,3})\s*[\.\):\-=]\s*(.+?)\s*$/);if(y&&!(+y[1]in m))m[+y[1]]=y[2]});return m}
function splitKey(t,sep){if(sep)return[t,sep];const ms=[...t.matchAll(/answer\s*key|answers?\s*:?\s*\n|solutions?\s*\n/gi)];const i=ms.length?ms[ms.length-1].index:-1;return i>t.length*.2?[t.slice(0,i),t.slice(i)]:[t,'']}
function parseQs(t){const p=('\n'+t).split(/\n\s*(?:Q(?:uestion)?\.?\s*)?(\d{1,3})\s*[\.\)\]:\-]\s*/i),out=[];
for(let i=1;i<p.length;i+=2){const no=+p[i],body=p[i+1].trim();
const ms=[...body.matchAll(/(?:^|\s)(?:\(([A-Da-d1-4])\)|([A-Da-d])[\)\.])\s*/g)];
if(ms.length>=4){const o=ms.map((m,k)=>body.slice(m.index+m[0].length,ms[k+1]?ms[k+1].index:body.length).trim());out.push({no,text:body.slice(0,ms[0].index).trim(),opts:o.slice(0,4)})}else out.push({no,text:body,opts:null})}return out}
const shuf=a=>a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(x=>x[1]);
function distract(ans,pool){const n=parseFloat(String(ans).replace(/,/g,''));let d=[];
if(!isNaN(n)&&/^[\d.,\s%₹$-]+$/.test(ans)){const s=Math.max(1,Math.round(Math.abs(n)*.1)),f=v=>String(Number.isInteger(n)?Math.round(v):+v.toFixed(2));d=[f(n+s),f(n-s),f(n*2),f(n+2*s),f(n-2*s),f(n/2)]}
else d=shuf(pool);return[...new Set(d.filter(x=>x&&x!=ans))].slice(0,3)}
async function aiCall(prompt){const k=localStorage.ak;if(!k)throw Error('Add your API key on Home first');
const r=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'content-type':'application/json','x-api-key':k,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},body:JSON.stringify({model:'claude-sonnet-5-5',max_tokens:600,messages:[{role:'user',content:prompt}]})});
const j=await r.json();if(!j.content)throw Error(j.error?.message||'API error');return j.content[0].text}
async function build(pid,qs,key){const pool=[...new Set(Object.values(key).filter(v=>v.length>1))],res=[];let skipped=0;
for(const q of qs){const v=key[q.no];if(!v){skipped++;continue}let opts=q.opts,ans,gen=false;
if(opts){const i=/^[1-4]$/.test(v)?+v-1:'ABCD'.indexOf(v[0]);ans=v.length==1&&i>=0?i:opts.findIndex(o=>o.toLowerCase().includes(v.toLowerCase()));if(ans<0){skipped++;continue}}
else{if(v.length==1&&/[A-E]/.test(v)){skipped++;continue}gen=true;let d=distract(v,pool);
if(localStorage.ak&&d.length<3)try{d=JSON.parse((await aiCall(`Question: ${q.text}\nCorrect answer: ${v}\nGive 3 plausible wrong options as a JSON array of strings only.`)).match(/\[[\s\S]*\]/)[0]).slice(0,3)}catch(e){}
while(d.length<3)d.push('None of these'+' '.repeat(d.length));opts=shuf([v,...d.slice(0,3)]);ans=opts.indexOf(v)}
res.push({id:pid+'-'+q.no,paperId:pid,no:q.no,text:q.text,opts,ans,gen,status:'new',tries:0})}
return{res,skipped}}
/* ---------- app state / views ---------- */
let P={},tab='home';const nav=[['home','🏠','Home'],['practice','✏️','Practice'],['mistakes','📕','Mistakes'],['revise','🔁','Revise'],['stats','📊','Stats']];
function go(t){tab=t;P={};render()}
async function render(){$('#nav').innerHTML=nav.map(n=>`<button class="${n[0]==tab?'on':''}" onclick="go('${n[0]}')">${n[1]}<br>${n[2]}</button>`).join('');
$('#app').innerHTML=await({home:vHome,practice:vPractice,mistakes:vMist,revise:vRev,stats:vStats}[tab])()}
async function vHome(){const ps=await all('papers'),qs=await all('questions');
return`<div class=c><h3>Add paper</h3><small>Question paper PDF</small><input type=file id=fq accept=application/pdf><small>Separate answer key PDF (optional – auto-detected if inside the paper)</small><input type=file id=fk accept=application/pdf>
<small>OCR language (for scanned PDFs)</small><select id=lg><option value=eng>English</option><option value=eng+mar>English + Marathi</option><option value=eng+hin>English + Hindi</option></select>
<label><input type=checkbox id=fo style=width:auto> Force OCR on every page (tick if scan gives 0 questions)</label><button onclick=importPdf()>Process PDF</button><small id=st></small><textarea id=dbg rows=8 style='width:100%;display:none'></textarea></div>
<div class=c><small>Anthropic API key (optional: AI explanations &amp; options)</small><input type=password id=ak value="${localStorage.ak||''}" onchange="localStorage.ak=this.value.trim()"></div>
<h3>Papers</h3>${ps.map(p=>{const q=qs.filter(x=>x.paperId==p.id);return`<div class=c><b>${esc(p.name)}</b><br><small>${q.length} questions · ${q.filter(x=>x.status!='new').length} attempted${p.skipped?` · ${p.skipped} skipped (no key match)`:''}</small><button onclick="start(${p.id},'new')">Practice new</button><button class=g onclick="start(${p.id},'all')">Redo all</button><button class=g onclick="del(${p.id})">Delete</button></div>`}).join('')||'<small>No papers yet.</small>'}`}
async function importPdf(){const f=$('#fq').files[0],st=t=>$('#st').textContent=t;if(!f)return st('Choose a PDF first');
try{const lg=$('#lg').value;let t=await readPdf(f,lg,st),sep=$('#fk').files[0]?await readPdf($('#fk').files[0],lg,st):'';
const[qt,kt]=splitKey(t,sep),key=parseKey(kt),qs=parseQs(qt);if(!qs.length||!Object.keys(key).length){$('#dbg').style.display='block';$('#dbg').value='--- QUESTION TEXT ---\n'+qt.slice(0,1200)+'\n--- KEY TEXT ---\n'+kt.slice(0,600);return st(`Found ${qs.length} questions, ${Object.keys(key).length} answers. Text shown below – send it to Claude.`)}
const pid=Date.now();st('Building options…');const{res,skipped}=await build(pid,qs,key);
await put('papers',{id:pid,name:f.name.replace(/\.pdf$/i,''),date:pid,skipped});await putMany('questions',res);st(`Imported ${res.length} questions`);setTimeout(()=>go('home'),800)}catch(e){st('Error: '+e.message)}}
async function del(id){if(!confirm('Delete this paper and its questions?'))return;const qs=(await all('questions')).filter(q=>q.paperId==id);await tx('questions','readwrite',o=>qs.forEach(q=>o.delete(q.id)));await tx('papers','readwrite',o=>o.delete(id));go('home')}
async function vPractice(){return`<div class=c><small>Pick a paper on Home and tap Practice.</small></div>`}
async function start(pid,m){let qs=(await all('questions')).filter(q=>q.paperId==pid&&(m=='all'||q.status=='new')).sort((a,b)=>a.no-b.no);tab='practice';P={qs,i:0,mode:m,right:0,n:0};$('#nav').querySelectorAll('button').forEach((b,i)=>b.classList.toggle('on',i==1));$('#app').innerHTML=card()}
function card(){const q=P.qs[P.i];P.done=0;if(!q)return`<div class=c><h3>Session complete 🎉</h3><p>${P.right}/${P.n} correct</p><button onclick="go('home')">Done</button></div>`;
return`<div class=c><small>${P.mode} · ${P.i+1}/${P.qs.length} · Q${q.no}${q.gen?' · options generated':''}</small><p class=q>${esc(q.text)}</p>${q.opts.map((o,k)=>`<button class=o id=o${k} onclick=pick(${k})>${'ABCD'[k]}. ${esc(o)}</button>`).join('')}<div id=fb></div></div>`}
const DAY=864e5,IV=[1,3,7,14,30];
async function pick(k){if(P.done)return;P.done=1;const q=P.qs[P.i],ok=k==q.ans,now=Date.now();P.n++;P.right+=ok;
$('#o'+q.ans).style.cssText='background:var(--ok);color:#fff';if(!ok)$('#o'+k).style.cssText='background:var(--bad);color:#fff';
q.tries++;q.last=now;
if(ok){if(q.status=='wrong'||q.status=='mastered'&&0){q.box=(q.box||0)+1;q.due=now+IV[Math.min(q.box,4)]*DAY;if(q.box>=3)q.status='mastered'}else if(q.status=='new')q.status='correct'}
else{q.status='wrong';q.box=0;q.due=now+DAY}
await put('questions',q);await put('attempts',{qid:q.id,ok:ok?1:0,ts:now});
$('#fb').innerHTML=`<p><b>${ok?'✅ Correct!':'❌ Wrong'}</b> — Answer: ${'ABCD'[q.ans]}. ${esc(q.opts[q.ans])}</p><div id=ex>${q.expl?esc(q.expl):''}</div>${q.expl?'':'<button class=g onclick=explain()>💡 Explain (AI)</button>'}<button onclick="P.i++;$('#app').innerHTML=card()">Next →</button>`}
async function explain(){const q=P.qs[P.i];$('#ex').textContent='Thinking…';try{q.expl=await aiCall(`Explain briefly (max 120 words) why "${q.opts[q.ans]}" is correct.\nQuestion: ${q.text}\nOptions: ${q.opts.join(' | ')}`);await put('questions',q);$('#ex').textContent=q.expl}catch(e){$('#ex').textContent=e.message}}
async function vMist(){const qs=(await all('questions')).filter(q=>q.status=='wrong').sort((a,b)=>a.no-b.no);
return`<h3>Mistake book (${qs.length})</h3>${qs.map(q=>`<div class=c><small>Q${q.no} · tried ${q.tries}×</small><p class=q>${esc(q.text)}</p><b style=color:var(--ok)>✔ ${'ABCD'[q.ans]}. ${esc(q.opts[q.ans])}</b>${q.expl?`<p><small>${esc(q.expl)}</small></p>`:''}</div>`).join('')||'<small>No mistakes. 👏</small>'}`}
async function vRev(){const qs=(await all('questions')).filter(q=>q.status=='wrong'&&(q.due||0)<=Date.now()),tot=(await all('questions')).filter(q=>q.status=='wrong').length;
window.revQs=qs;return`<div class=c><h3>Revision</h3><p>${qs.length} due now · ${tot} total in mistake book</p>${qs.length?`<button onclick="startRev()">Start revision</button>`:''}<small>Spaced repetition: 1, 3, 7, 14, 30 days. Answer correctly 3× to master a question.</small></div>`}
function startRev(){P={qs:shuf(window.revQs),i:0,mode:'revision',right:0,n:0};$('#app').innerHTML=card()}
const dk=d=>d.toLocaleDateString('en-CA'),wk=d=>{const x=new Date(d);x.setDate(x.getDate()-(x.getDay()+6)%7);return dk(x)},mk=d=>dk(d).slice(0,7);
const agg=(a,f)=>{const m={};a.forEach(x=>{const k=f(new Date(x.ts));(m[k]??={n:0,c:0}).n++;m[k].c+=x.ok});return m};
const rows=(m,ks)=>ks.map(k=>{const v=m[k]||{n:0,c:0};return`<div class=r><span>${k}</span><div class=bar><i style="width:${v.n?v.c/v.n*100:0}%"></i></div><span>${v.c}/${v.n}</span></div>`}).join('');
async function vStats(){const a=await all('attempts'),N=new Date(),ago=n=>new Date(N-n*DAY);
const days=[...Array(7)].map((_,i)=>dk(ago(i))),wks=[...Array(4)].map((_,i)=>wk(ago(i*7))),mos=[...Array(6)].map((_,i)=>mk(new Date(N.getFullYear(),N.getMonth()-i,15)));
const c=a.reduce((s,x)=>s+x.ok,0);return`<div class=c><h3>Overall</h3>${a.length} attempts · ${a.length?Math.round(c/a.length*100):0}% accuracy</div>
<div class=c><b>Daily</b>${rows(agg(a,dk),days)}</div><div class=c><b>Weekly (week start)</b>${rows(agg(a,wk),wks)}</div><div class=c><b>Monthly</b>${rows(agg(a,mk),mos)}</div><small>Bar = accuracy, right side = correct/attempted.</small>`}
render();
</script></body></html>
